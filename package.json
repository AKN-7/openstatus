{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "env": "bun env.ts",
    "lint": "biome lint .",
    "format": "pnpm biome format . --write && pnpm biome check . --write ",
    "format:fix": "pnpm biome check --fix --unsafe .",
    "lint:fix": "pnpm biome lint --write --unsafe .",
    "lint:turbo": "turbo run lint",
    "lint:oxc": "oxlint .",
    "lint:oxc-type": "oxlint . --type-aware --fix --fix-suggestions",
    "format:oxc": "oxfmt --check",
    "dev:web": "turbo run dev --filter='./apps/web' --filter='./packages/db'",
    "dev:status-page": "turbo run dev --filter='./apps/status-page' --filter='./packages/db'",
    "dev:dashboard": "turbo run dev --filter='./apps/dashboard' --filter='./packages/db'",
    "dx": "turbo run dx",
    "tsc": "tsc",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@turbo/gen": "1.13.3",
    "oxfmt": "0.20.0",
    "oxlint": "1.36.0",
    "oxlint-tsgolint": "0.10.1",
    "@types/node": "24.0.8",
    "knip": "5.75.1",
    "turbo": "2.6.3",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.26.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "@swc/core",
      "sharp"
    ],
    "overrides": {
      "@react-email/preview-server>next": "16.4.5",
      "protobufjs@7": "^7.6.6",
      "tar@7": "^7.5.22",
      "undici@5": "^6.29.1",
      "ws@8": "^8.22.1",
      "jws@4": "^4.0.1",
      "form-data@2": "^2.5.6",
      "@grpc/grpc-js": "^1.14.7",
      "engine.io@6": "^6.6.11",
      "socket.io-parser@4": "^4.2.7",
      "postcss@8": "^8.5.18",
      "nanoid@3": "^3.3.20",
      "nanoid@5": "^5.1.16",
      "rollup@3": "^3.30.0",
      "rollup@4": "^4.59.0",
      "serialize-javascript@6": "^7.0.3",
      "source-map-js@1": "^1.2.2",
      "@trpc/server": "11.24.0",
      "handlebars@4": "^4.7.10",
      "basic-ftp@5": "^5.3.1",
      "tinypool@2": "^2.1.2",
      "picomatch@4": "^4.0.7",
      "smol-toml@1": "^1.7.1",
      "lodash@4": "^4.18.0",
      "js-yaml@4": "^4.3.2",
      "ip-address@10": "^10.3.1",
      "minimatch@3": "^3.1.4",
      "minimatch@9": "^9.0.6",
      "minimatch@10": "^10.2.3",
      "minimatch@7": "^7.4.8",
      "brace-expansion@1": "^1.1.20",
      "brace-expansion@2": "^2.1.6",
      "@isaacs/brace-expansion@5": "^5.0.1",
      "browserslist@4": "^4.28.7",
      "fast-uri@3": "^3.1.7",
      "body-parser@2": "^2.4.0",
      "@modelcontextprotocol/sdk": "^1.32.0",
      "defu@6": "^6.1.5",
      "h3@1": "^1.15.6",
      "devalue@5": "^5.9.3",
      "fast-xml-parser": "^5.5.7",
